# PORT
PORT=3000
CORS_ORIGIN=https://tunas-ai.web.id,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Model inference
AI_PROVIDER=gemini
AI_MODEL=gemini-3.1-flash-lite
AI_API_KEY=

# DB
DATABASE_URL=
DIRECT_URL=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

# Keys
MISSION_PREVIEW_SECRET=
APP_ENCRYPTION_KEY=
GOOGLE_OAUTH_STATE_SECRET=

# Agent debugging: prints raw model outputs, including farm and chat data, to backend logs
NODE_ENV=
AGENT_DEBUG_RAW_OUTPUT=false
# Legacy alias; use AGENT_DEBUG_RAW_OUTPUT for all agents.
MISSION_DEBUG_RAW_OUTPUT=false
# Logs backend request durations without request bodies or tokens.
PERFORMANCE_DEBUG=false

# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=

# Telegram. Set all four values together; Docker Compose starts the ngrok sidecar.
TELEGRAM_BOT_TOKEN=
NGROK_AUTHTOKEN=
# Reserved HTTPS endpoint, for example https://your-name.ngrok.app (hostname also accepted).
NGROK_DOMAIN=
# Telegram sends this value in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=
