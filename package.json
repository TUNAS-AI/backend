{
  "name": "hijau-ai-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:production": "prisma migrate deploy --config prisma.config.ts && node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test $(find src -name '*.test.ts' -print)",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio --config prisma.config.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.3",
    "@langchain/google": "^0.2.1",
    "@langchain/langgraph": "^1.4.8",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.110.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "langsmith": "^0.8.2",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
