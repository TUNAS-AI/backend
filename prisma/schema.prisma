generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "auth"]
}

model AuthUser {
  id              String @id @db.Uuid
  email           String? @db.Text
  rawUserMetaData Json?  @map("raw_user_meta_data") @db.JsonB
  profile         User?  @relation("AuthUserProfile")

  @@map("users")
  @@schema("auth")
}

model User {
  id          String   @id @db.Uuid
  email       String?  @unique @db.Text
  displayName String?  @map("display_name") @db.Text
  locale      String   @default("id") @db.Text
  timezone    String   @default("Asia/Jakarta") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  authUser    AuthUser @relation("AuthUserProfile", fields: [id], references: [id], onDelete: Cascade)
  farm        Farm?

  @@map("users")
  @@schema("public")
}

model Farm {
  farmId                    String                       @id @default(uuid()) @map("farm_id") @db.Uuid
  ownerId                   String                       @unique @map("owner_id") @db.Uuid
  name                      String                       @db.Text
  location                  String?                      @db.Text
  notes                     String?                      @db.Text
  timezone                  String                       @default("Asia/Jakarta") @db.Text
  defaultWorkingHours       Json?                        @map("default_working_hours") @db.JsonB
  defaultWorkerCount        Int                          @default(1) @map("default_worker_count")
  createdAt                 DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner                     User                         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  fieldBlocks               FieldBlock[]
  cropBatches               CropBatch[]
  fieldObservations         FieldObservation[]
  weatherSnapshots          WeatherSnapshot[]
  missions                  Mission[]
  tunasMessages             TunasMessage[]
  tunasForecastChecks       TunasForecastCheck[]
  googleCalendarConnection  GoogleCalendarConnection?

  @@map("farms")
  @@schema("public")
}

model GoogleCalendarConnection {
  googleCalendarConnectionId String   @id @default(uuid()) @map("google_calendar_connection_id") @db.Uuid
  farmId                     String   @unique @map("farm_id") @db.Uuid
  calendarId                 String   @default("primary") @map("calendar_id") @db.Text
  encryptedAccessToken       String   @map("encrypted_access_token") @db.Text
  encryptedRefreshToken      String   @map("encrypted_refresh_token") @db.Text
  tokenExpiresAt             DateTime @map("token_expires_at") @db.Timestamptz(6)
  scopes                     String   @db.Text
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  farm                       Farm     @relation(fields: [farmId], references: [farmId], onDelete: Cascade)

  @@map("google_calendar_connections")
  @@schema("public")
}

model Mission {
  missionId       String                @id @default(uuid()) @map("mission_id") @db.Uuid
  farmId          String                @map("farm_id") @db.Uuid
  fieldBlockId    String?               @map("field_block_id") @db.Uuid
  status          String                @default("ACTIVE") @db.Text
  stage           String                @default("WAITING") @db.Text
  originalMessage String                @map("original_message") @db.Text
  notes           String?               @db.Text
  approvedPlanId  String?               @map("approved_plan_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  farm            Farm                  @relation(fields: [farmId], references: [farmId], onDelete: Cascade)
  fieldBlock      FieldBlock?           @relation("MissionFieldBlock", fields: [farmId, fieldBlockId], references: [farmId, fieldBlockId])
  cropBatches     MissionCropBatch[]    @relation("MissionCropBatches")
  messages        MissionMessage[]
  tunasMessages   TunasMessage[]
  clarifications  MissionClarification[]
  constraints     MissionConstraint[]
  planningRuns    PlanningRun[]
  plans           Plan[]
  missionSteps    MissionStep[]
  closeout        MissionCloseout?

  @@index([farmId, createdAt])
  @@unique([farmId, missionId])
  @@map("missions")
  @@schema("public")
}

model MissionCropBatch {
  missionId   String    @map("mission_id") @db.Uuid
  farmId      String    @map("farm_id") @db.Uuid
  cropBatchId String    @map("crop_batch_id") @db.Uuid
  mission     Mission   @relation("MissionCropBatches", fields: [farmId, missionId], references: [farmId, missionId], onDelete: Cascade)
  cropBatch   CropBatch @relation("MissionCropBatches", fields: [farmId, cropBatchId], references: [farmId, cropBatchId])

  @@id([missionId, cropBatchId])
  @@index([farmId, cropBatchId])
  @@map("mission_crop_batches")
  @@schema("public")
}

model MissionMessage {
  missionMessageId String   @id @default(uuid()) @map("mission_message_id") @db.Uuid
  missionId        String   @map("mission_id") @db.Uuid
  role             String   @db.Text
  content          String   @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  mission          Mission  @relation(fields: [missionId], references: [missionId], onDelete: Cascade)

  @@index([missionId, createdAt])
  @@map("mission_messages")
  @@schema("public")
}

model MissionClarification {
  missionClarificationId String   @id @default(uuid()) @map("mission_clarification_id") @db.Uuid
  missionId              String   @map("mission_id") @db.Uuid
  key                    String   @db.Text
  question               String   @db.Text
  answer                 String?  @db.Text
  status                 String   @default("OPEN") @db.Text
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  answeredAt             DateTime? @map("answered_at") @db.Timestamptz(6)
  mission                Mission  @relation(fields: [missionId], references: [missionId], onDelete: Cascade)

  @@index([missionId, status])
  @@map("mission_clarifications")
  @@schema("public")
}

model MissionConstraint {
  missionConstraintId String   @id @default(uuid()) @map("mission_constraint_id") @db.Uuid
  missionId           String   @map("mission_id") @db.Uuid
  key                 String   @db.Text
  value               Json     @db.JsonB
  provenance          String   @default("INFERRED") @db.Text
  confidence          String   @default("medium") @db.Text
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  mission             Mission  @relation(fields: [missionId], references: [missionId], onDelete: Cascade)

  @@unique([missionId, key])
  @@map("mission_constraints")
  @@schema("public")
}

model PlanningRun {
  planningRunId String    @id @default(uuid()) @map("planning_run_id") @db.Uuid
  missionId     String    @map("mission_id") @db.Uuid
  status        String    @default("PENDING") @db.Text
  error         String?   @db.Text
  traceId       String?   @map("trace_id") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)
  mission       Mission   @relation(fields: [missionId], references: [missionId], onDelete: Cascade)
  plans         Plan[]

  @@index([missionId, createdAt])
  @@map("planning_runs")
  @@schema("public")
}

model Plan {
  planId        String      @id @default(uuid()) @map("plan_id") @db.Uuid
  missionId     String      @map("mission_id") @db.Uuid
  planningRunId String      @map("planning_run_id") @db.Uuid
  name          String      @db.Text
  summary       String      @db.Text
  recommended   Boolean     @default(false)
  assumptions   Json        @default("[]") @db.JsonB
  risks         Json        @default("{}") @db.JsonB
  dryingEstimateDays Decimal @map("drying_estimate_days") @db.Decimal(5, 2)
  dryingEstimateReason String @map("drying_estimate_reason") @db.Text
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  mission       Mission     @relation(fields: [missionId], references: [missionId], onDelete: Cascade)
  planningRun   PlanningRun @relation(fields: [planningRunId], references: [planningRunId], onDelete: Cascade)
  steps         PlanStep[]

  @@index([missionId, createdAt])
  @@map("plans")
  @@schema("public")
}

model PlanStep {
  planStepId    String   @id @default(uuid()) @map("plan_step_id") @db.Uuid
  planId        String   @map("plan_id") @db.Uuid
  sequence      Int
  title         String   @db.Text
  description   String   @db.Text
  scheduleType  String   @default("DAILY_WINDOW") @map("schedule_type") @db.Text
  startsOn      DateTime @map("starts_on") @db.Date
  endsOn        DateTime @map("ends_on") @db.Date
  windowStart   String?  @map("window_start") @db.Text
  windowEnd     String?  @map("window_end") @db.Text
  timezone      String   @db.Text
  isConditional Boolean  @default(false) @map("is_conditional")
  stage         String   @default("HARVESTING") @db.Text
  targetHarvestKg Decimal? @map("target_harvest_kg") @db.Decimal(14, 3)
  calendarSyncStatus    String   @default("NOT_REQUESTED") @map("calendar_sync_status") @db.Text
  googleCalendarEventId String?  @map("google_calendar_event_id") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  plan          Plan     @relation(fields: [planId], references: [planId], onDelete: Cascade)

  @@unique([planId, sequence])
  @@map("plan_steps")
  @@schema("public")
}

model MissionStep {
  missionStepId          String   @id @default(uuid()) @map("mission_step_id") @db.Uuid
  missionId              String   @map("mission_id") @db.Uuid
  sourcePlanStepId       String   @map("source_plan_step_id") @db.Uuid
  sequence               Int
  title                  String   @db.Text
  description            String   @db.Text
  scheduleType           String   @default("DAILY_WINDOW") @map("schedule_type") @db.Text
  startsOn               DateTime @map("starts_on") @db.Date
  endsOn                 DateTime @map("ends_on") @db.Date
  windowStart            String?  @map("window_start") @db.Text
  windowEnd              String?  @map("window_end") @db.Text
  timezone               String   @db.Text
  isConditional          Boolean  @default(false) @map("is_conditional")
  stage                  String   @default("HARVESTING") @db.Text
  targetHarvestKg        Decimal? @map("target_harvest_kg") @db.Decimal(14, 3)
  status                 String   @default("SCHEDULED") @db.Text
  calendarSyncStatus     String   @default("NOT_REQUESTED") @map("calendar_sync_status") @db.Text
  googleCalendarEventId  String?  @map("google_calendar_event_id") @db.Text
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  mission                Mission  @relation(fields: [missionId], references: [missionId], onDelete: Cascade)

  @@unique([missionId, sequence])
  @@map("mission_steps")
  @@schema("public")
}

model MissionCloseout {
  missionCloseoutId String   @id @default(uuid()) @map("mission_closeout_id") @db.Uuid
  missionId         String   @unique @map("mission_id") @db.Uuid
  plannedHarvestKg  Decimal  @map("planned_harvest_kg") @db.Decimal(14, 3)
  plannedDriedKg    Decimal  @map("planned_dried_kg") @db.Decimal(14, 3)
  actualHarvestKg   Decimal  @map("actual_harvest_kg") @db.Decimal(14, 3)
  actualDriedKg     Decimal  @map("actual_dried_kg") @db.Decimal(14, 3)
  harvestedAreaHectares Decimal? @map("harvested_area_hectares") @db.Decimal(12, 4)
  dryingCompleted   Boolean  @map("drying_completed")
  rejectedKg        Decimal? @map("rejected_kg") @db.Decimal(14, 3)
  notes             String?  @db.Text
  summary           Json?    @map("summary") @db.JsonB
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  mission           Mission  @relation(fields: [missionId], references: [missionId], onDelete: Cascade)

  @@map("mission_closeouts")
  @@schema("public")
}

model FieldBlock {
  fieldBlockId      String             @id @default(uuid()) @map("field_block_id") @db.Uuid
  farmId            String             @map("farm_id") @db.Uuid
  name              String             @db.Text
  areaHectares      Decimal?           @map("area_hectares") @db.Decimal(12, 4)
  latitude          Decimal            @db.Decimal(9, 6)
  longitude         Decimal            @db.Decimal(9, 6)
  notes             String?            @db.Text
  status            String             @default("active") @db.Text
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  farm              Farm               @relation(fields: [farmId], references: [farmId], onDelete: Cascade)
  cropBatches       CropBatch[]       @relation("FieldBlockCropBatches")
  fieldObservations FieldObservation[] @relation("FieldBlockFieldObservations")
  weatherSnapshots  WeatherSnapshot[]
  missions          Mission[]          @relation("MissionFieldBlock")

  @@unique([farmId, name])
  @@unique([farmId, fieldBlockId])
  @@index([farmId])
  @@map("field_blocks")
  @@schema("public")
}

model CropBatch {
  cropBatchId       String              @id @default(uuid()) @map("crop_batch_id") @db.Uuid
  farmId            String              @map("farm_id") @db.Uuid
  fieldBlockId      String              @map("field_block_id") @db.Uuid
  crop              String              @db.Text
  variety           String?             @db.Text
  plantingDate      DateTime?           @map("planting_date") @db.Date
  notes             String?             @db.Text
  status            String              @default("active") @db.Text
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  farm              Farm                @relation(fields: [farmId], references: [farmId], onDelete: Cascade)
  fieldBlock        FieldBlock          @relation("FieldBlockCropBatches", fields: [farmId, fieldBlockId], references: [farmId, fieldBlockId], onDelete: Cascade)
  missionLinks      MissionCropBatch[]  @relation("MissionCropBatches")

  @@index([farmId, fieldBlockId])
  @@index([fieldBlockId])
  @@unique([farmId, cropBatchId])
  @@unique([farmId, fieldBlockId, cropBatchId])
  @@map("crop_batches")
  @@schema("public")
}

model FieldObservation {
  fieldObservationId String     @id @default(uuid()) @map("field_observation_id") @db.Uuid
  farmId             String     @map("farm_id") @db.Uuid
  fieldBlockId       String     @map("field_block_id") @db.Uuid
  cropBatchId        String?    @map("crop_batch_id") @db.Uuid
  observationType    String     @map("observation_type") @db.Text
  observedAt         DateTime   @map("observed_at") @db.Timestamptz(6)
  payload            Json       @default("{}") @db.JsonB
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  farm               Farm       @relation(fields: [farmId], references: [farmId], onDelete: Cascade)
  fieldBlock         FieldBlock @relation("FieldBlockFieldObservations", fields: [farmId, fieldBlockId], references: [farmId, fieldBlockId], onDelete: Cascade)

  @@index([farmId, observedAt])
  @@index([fieldBlockId, observedAt])
  @@index([cropBatchId, observedAt])
  @@map("field_observations")
  @@schema("public")
}

model WeatherSnapshot {
  weatherSnapshotId String   @id @default(uuid()) @map("weather_snapshot_id") @db.Uuid
  farmId            String   @map("farm_id") @db.Uuid
  fieldBlockId      String   @map("field_block_id") @db.Uuid
  source            String   @db.Text
  observedAt        DateTime @map("observed_at") @db.Timestamptz(6)
  payload           Json     @db.JsonB
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  farm              Farm     @relation(fields: [farmId], references: [farmId], onDelete: Cascade)
  fieldBlock        FieldBlock @relation(fields: [farmId, fieldBlockId], references: [farmId, fieldBlockId], onDelete: Cascade)

  @@index([farmId, observedAt])
  @@index([fieldBlockId, observedAt])
  @@map("weather_snapshots")
  @@schema("public")
}

model TunasMessage {
  tunasMessageId String    @id @default(uuid()) @map("tunas_message_id") @db.Uuid
  farmId         String    @map("farm_id") @db.Uuid
  missionId      String?   @map("mission_id") @db.Uuid
  kind           String    @db.Text
  role           String    @default("assistant") @db.Text
  content        String    @db.Text
  actions        Json      @default("[]") @db.JsonB
  dedupeKey      String?   @map("dedupe_key") @db.Text
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  farm           Farm      @relation(fields: [farmId], references: [farmId], onDelete: Cascade)
  mission        Mission?  @relation(fields: [missionId], references: [missionId], onDelete: Cascade)

  @@unique([farmId, dedupeKey])
  @@index([farmId, createdAt])
  @@map("tunas_messages")
  @@schema("public")
}

model TunasForecastCheck {
  tunasForecastCheckId String   @id @default(uuid()) @map("tunas_forecast_check_id") @db.Uuid
  farmId               String   @map("farm_id") @db.Uuid
  forecastDate         DateTime @map("forecast_date") @db.Date
  checkedAt            DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)
  farm                 Farm     @relation(fields: [farmId], references: [farmId], onDelete: Cascade)

  @@unique([farmId, forecastDate])
  @@map("tunas_forecast_checks")
  @@schema("public")
}
